{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import"],
  "categories": {
    "correctness": "warn",
    "suspicious": "warn"
  },
  "rules": {
    "import/no-unassigned-import": "off"
  },
  "settings": {},
  "env": {
    "builtin": true,
    "browser": true
  },
  "ignorePatterns": ["dist", "node_modules"],
  "options": {
    "typeAware": true,
    "typeCheck": true
  }
}
